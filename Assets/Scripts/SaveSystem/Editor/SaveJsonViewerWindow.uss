.save-json-viewer-root {
    flex-grow: 1;
    background-color: rgb(38, 38, 38);
    color: rgb(218, 218, 218);
}

.toolbar {
    min-height: 38px;
    flex-direction: row;
    align-items: center;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgb(31, 31, 31);
    border-bottom-width: 1px;
    border-bottom-color: rgb(17, 17, 17);
}

.toolbar-button {
    min-width: 92px;
    height: 28px;
    margin-right: 6px;
}

.primary-button {
    background-color: rgb(52, 93, 135);
}

.status-label {
    flex-grow: 1;
    margin-left: 6px;
    color: rgb(176, 176, 176);
    -unity-text-align: middle-left;
}

.main-layout {
    flex-grow: 1;
    flex-direction: row;
}

.slot-panel {
    min-width: 340px;
    width: 380px;
    flex-shrink: 0;
    background-color: rgb(45, 45, 45);
    border-right-width: 1px;
    border-right-color: rgb(19, 19, 19);
}

.panel-title {
    height: 44px;
    padding-left: 10px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.slot-list {
    flex-grow: 1;
    border-top-width: 1px;
    border-top-color: rgb(24, 24, 24);
}

.save-row {
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(37, 37, 37);
}

.save-row-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.save-row-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(224, 224, 224);
}

.save-row-details {
    margin-top: 3px;
    font-size: 11px;
    color: rgb(156, 156, 156);
}

.save-row-state {
    min-width: 70px;
    min-height: 34px;
    padding-left: 4px;
    padding-right: 4px;
    -unity-text-align: middle-center;
    color: rgb(205, 205, 205);
    background-color: rgb(61, 61, 61);
}

.save-row-state.is-available {
    color: rgb(218, 240, 221);
    background-color: rgb(54, 81, 62);
}

.save-row-state.is-corrupted {
    color: rgb(245, 214, 214);
    background-color: rgb(86, 57, 57);
}

.payload-panel {
    min-width: 520px;
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
}

.metadata-label {
    min-height: 106px;
    padding-top: 8px;
    padding-bottom: 8px;
    white-space: normal;
    color: rgb(177, 177, 177);
}

.payload-scroll {
    flex-grow: 1;
    background-color: rgb(30, 30, 30);
    border-width: 1px;
    border-color: rgb(17, 17, 17);
}

.json-text {
    flex-grow: 1;
    min-height: 360px;
    margin: 8px;
}
