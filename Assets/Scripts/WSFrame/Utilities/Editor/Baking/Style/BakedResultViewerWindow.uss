.baked-result-window {
    flex-grow: 1;
    min-width: 0;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
}

.baked-result-header {
    flex-direction: column;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    background-color: rgb(42, 48, 57);
    border-left-width: 3px;
    border-left-color: rgb(79, 143, 214);
}

.baked-result-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.baked-result-source,
.baked-result-status {
    margin-top: 4px;
    font-size: 11px;
    color: rgb(177, 187, 200);
}

.baked-result-toolbar {
    flex-direction: row;
    margin-bottom: 8px;
}

.baked-result-toolbar > Button {
    min-width: 92px;
    margin-right: 6px;
}

.baked-result-table {
    flex-grow: 1;
    min-height: 120px;
    border-top-width: 1px;
    border-top-color: rgb(72, 72, 72);
}

.baked-result-table .unity-multi-column-view__cell {
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-left;
}
