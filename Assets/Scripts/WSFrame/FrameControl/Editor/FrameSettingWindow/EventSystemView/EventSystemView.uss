.event-system-view {
    flex-grow: 1;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

.event-toolbar {
    flex-direction: column;
    padding-top: 10px;
    padding-right: 12px;
    padding-bottom: 10px;
    padding-left: 12px;
    margin-bottom: 10px;
    background-color: rgb(43, 43, 43);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(58, 58, 58);
    border-right-color: rgb(58, 58, 58);
    border-top-color: rgb(58, 58, 58);
    border-bottom-color: rgb(58, 58, 58);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.event-action-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.event-filter-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.event-button {
    height: 32px;
    margin-right: 6px;
    margin-bottom: 4px;
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.event-button-primary {
    min-width: 220px;
    background-color: rgb(50, 105, 150);
}

.event-button-neutral {
    min-width: 112px;
    background-color: rgb(70, 70, 70);
}

.event-field {
    min-width: 180px;
    height: 32px;
    margin-right: 8px;
    margin-bottom: 4px;
}

.event-field-label {
    -unity-font-style: bold;
}

.event-search-field {
    min-width: 240px;
    max-width: 420px;
    flex-grow: 1;
}

.event-summary {
    min-width: 150px;
    height: 32px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    -unity-font-style: bold;
    color: rgb(190, 210, 225);
}

.event-results {
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

.event-content-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    width: 100%;
}

.event-results-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 2px;
    margin-bottom: 8px;
    color: rgb(215, 215, 215);
}

.event-card {
    flex-grow: 1;
    margin-bottom: 8px;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
    background-color: rgb(38, 38, 38);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(62, 62, 62);
    border-right-color: rgb(62, 62, 62);
    border-top-color: rgb(62, 62, 62);
    border-bottom-color: rgb(62, 62, 62);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.event-card-header {
    flex-direction: row;
    align-items: center;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    background-color: rgb(43, 55, 66);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    margin-bottom: 6px;
}

.event-log-console {
    flex-shrink: 0;
    min-height: 0;
    max-height: 450px;
    margin-bottom: 10px;
    padding-top: 6px;
    padding-right: 8px;
    padding-bottom: 6px;
    padding-left: 8px;
    background-color: rgb(34, 39, 44);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(63, 74, 83);
    border-right-color: rgb(63, 74, 83);
    border-top-color: rgb(63, 74, 83);
    border-bottom-color: rgb(63, 74, 83);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.event-log-foldout {
    flex-grow: 1;
    min-height: 0;
}

.event-log-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 4px;
}

.event-log-toggle {
    min-width: 118px;
    margin-right: 8px;
    margin-bottom: 3px;
}

.event-log-token-field {
    min-width: 190px;
    flex-grow: 1;
    max-width: 420px;
    margin-right: 8px;
    margin-bottom: 3px;
}

.event-log-count,
.event-log-status {
    min-width: 86px;
    margin-right: 8px;
    margin-bottom: 3px;
    color: rgb(186, 203, 214);
}

.event-log-status {
    min-width: 120px;
}

.event-log-list {
    flex-shrink: 1;
    min-height: 42px;
    max-height: 198px;
    margin-bottom: 5px;
    background-color: rgb(27, 30, 33);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(56, 63, 69);
    border-right-color: rgb(56, 63, 69);
    border-top-color: rgb(56, 63, 69);
    border-bottom-color: rgb(56, 63, 69);
}

.event-log-row {
    min-height: 23px;
    margin-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    color: rgb(211, 219, 224);
    background-color: rgb(43, 47, 51);
}

.event-log-warning {
    color: rgb(235, 207, 142);
}

.event-log-error {
    color: rgb(239, 161, 161);
}

.event-log-details {
    min-height: 24px;
    max-height: 92px;
    flex-shrink: 1;
    background-color: rgb(27, 30, 33);
}

.event-log-detail-field {
    flex-grow: 1;
    min-height: 52px;
    white-space: normal;
}

.event-log-details-placeholder {
    color: rgb(145, 157, 166);
    margin-top: 4px;
}

.event-name-label {
    flex-grow: 1;
    white-space: normal;
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(235, 235, 235);
}

.event-count {
    min-width: 88px;
    margin-left: 6px;
    padding-top: 2px;
    padding-right: 6px;
    padding-bottom: 2px;
    padding-left: 6px;
    background-color: rgb(52, 52, 52);
    color: rgb(195, 210, 220);
    -unity-text-align: middle-center;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.event-center-tag {
    background-color: rgb(54, 77, 96);
}

.event-generic-tag {
    background-color: rgb(91, 76, 51);
    color: rgb(245, 225, 185);
}

.event-generic-tag-hidden {
    display: none;
}

.event-section-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.event-section {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 260px;
    margin-top: 4px;
    margin-right: 6px;
}

.publisher-section {
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    background-color: rgb(50, 50, 50);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(70, 70, 70);
    border-right-color: rgb(70, 70, 70);
    border-top-color: rgb(70, 70, 70);
    border-bottom-color: rgb(70, 70, 70);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
}

.publisher-section .event-script-list {
    background-color: rgb(50, 50, 50);
}

.event-foldout {
    font-size: 13px;
    -unity-font-style: bold;
}

.event-script-list {
    flex-grow: 1;
    max-height: 260px;
    padding-top: 2px;
    padding-left: 12px;
}

.event-script-field {
    height: 24px;
    margin-bottom: 2px;
}
