.sample-graph-node--output .ws-graph-node__title {
    background-color: rgb(45, 84, 108);
}

.sample-graph-node--input .ws-graph-node__title {
    background-color: rgb(93, 67, 105);
}

.sample-graph-node--output .ws-graph-node__content {
    background-color: rgba(36, 70, 88, 0.32);
}

.sample-graph-node--input .ws-graph-node__content {
    background-color: rgba(78, 52, 87, 0.32);
}

.sample-graph-node--output .ws-graph-node__port--output,
.sample-graph-node--input .ws-graph-node__port--input {
    margin-top: 2px;
    margin-bottom: 2px;
}

.sample-graph-node--output.ws-graph-node--selected,
.sample-graph-node--input.ws-graph-node--selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(255, 196, 72);
    border-right-color: rgb(255, 196, 72);
    border-bottom-color: rgb(255, 196, 72);
    border-left-color: rgb(255, 196, 72);
}
