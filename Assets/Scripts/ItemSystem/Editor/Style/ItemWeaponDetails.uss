.item-editor-weapon-details {
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.item-editor-weapon-field-group {
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
}

.item-editor-weapon-stage-groups {
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    margin-top: 8px;
    padding-top: 2px;
    border-top-width: 1px;
    border-top-color: rgb(72, 72, 72);
}

.item-editor-subsection-title {
    margin-top: 8px;
    margin-bottom: 4px;
    padding-bottom: 3px;
    color: rgb(180, 205, 225);
    -unity-font-style: bold;
}

.item-editor-stage-list {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.item-editor-weapon-field-group > .item-editor-property-field {
    width: auto;
    margin-bottom: 6px;
}

.item-editor-weapon-field-group .unity-list-view,
.item-editor-weapon-field-group .unity-list-view__reorderable-item,
.item-editor-weapon-field-group .unity-list-view__reorderable-item-content,
.item-editor-weapon-field-group .unity-base-field__input {
    min-width: 0;
    max-width: 100%;
}

.item-editor-weapon-help {
    margin-top: 6px;
    margin-bottom: 8px;
    min-width: 0;
    max-width: 100%;
    padding: 6px 8px;
    background-color: rgb(42, 59, 70);
    border-left-width: 3px;
    border-left-color: rgb(90, 170, 220);
}

.item-editor-weapon-help-text {
    min-width: 0;
    white-space: normal;
    color: rgb(190, 220, 235);
}

.item-editor-weapon-warning {
    margin-top: 6px;
    margin-bottom: 8px;
    min-width: 0;
    max-width: 100%;
    padding: 6px 8px;
    background-color: rgb(74, 59, 42);
    border-left-width: 3px;
    border-left-color: rgb(220, 160, 75);
}

.item-editor-weapon-warning-text {
    min-width: 0;
    white-space: normal;
    color: rgb(245, 215, 165);
}

.item-editor-baked-summary {
    min-width: 0;
    max-width: 100%;
}

.item-editor-baked-summary {
    margin-top: 8px;
    padding: 8px;
    background-color: rgb(45, 66, 78);
    color: rgb(190, 225, 245);
}

.item-editor-baked-actions {
    flex-direction: row;
    margin-top: 6px;
}

.item-editor-baked-actions > Button {
    margin-right: 6px;
}
