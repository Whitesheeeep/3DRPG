<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Style src="project://database/Assets/Scripts/ItemSystem/Editor/Style/ItemDevelopmentDetails.uss" />
    <ui:VisualElement name="DevelopmentExperienceDetailsRoot" class="item-editor-development-details">
        <ui:Label text="养成经验道具配置" class="item-editor-section-title" />
        <uie:PropertyField name="ExperienceTypesField" binding-path="experienceTypes" label="经验适用对象" class="item-editor-property-field" />
        <uie:PropertyField name="ExperienceValueField" binding-path="experienceValue" label="提供经验值" class="item-editor-property-field" />
    </ui:VisualElement>
</ui:UXML>
