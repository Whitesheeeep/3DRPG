.item-editor-baked-row-host {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.item-editor-baked-row {
    flex-direction: row;
    min-width: 0;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.item-editor-baked-cell {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 72px;
    padding-left: 6px;
    padding-right: 6px;
    font-size: 11px;
    color: rgb(210, 210, 210);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.item-editor-baked-cell--level {
    flex-grow: 0;
    width: 58px;
    min-width: 58px;
}
