.item-editor-artifact-details {
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.item-editor-artifact-field-group {
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    flex-shrink: 1;
}

.item-editor-artifact-field-group > .item-editor-property-field {
    width: auto;
    margin-bottom: 6px;
}

.item-editor-artifact-field-group .unity-list-view,
.item-editor-artifact-field-group .unity-list-view__reorderable-item,
.item-editor-artifact-field-group .unity-list-view__reorderable-item-content,
.item-editor-artifact-field-group .unity-base-field__input {
    min-width: 0;
    max-width: 100%;
}

.item-editor-artifact-warning {
    margin-top: 6px;
    margin-bottom: 8px;
    min-width: 0;
    max-width: 100%;
    padding: 6px 8px;
    background-color: rgb(74, 59, 42);
    border-left-width: 3px;
    border-left-color: rgb(220, 160, 75);
}

.item-editor-artifact-warning-text {
    min-width: 0;
    white-space: normal;
    color: rgb(245, 215, 165);
}

/* 圣遗物详情只保留结果摘要和独立窗口入口。 */
.item-editor-baked-summary {
    min-width: 0;
    max-width: 100%;
}

.item-editor-baked-summary {
    margin-top: 8px;
    padding: 8px;
    background-color: rgb(45, 66, 78);
    color: rgb(190, 225, 245);
}

.item-editor-baked-actions {
    flex-direction: row;
    margin-top: 6px;
}

.item-editor-baked-actions > Button {
    margin-right: 6px;
}
