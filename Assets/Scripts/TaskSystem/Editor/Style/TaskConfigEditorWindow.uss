.task-editor-root {
    flex-grow: 1;
    padding: 8px;
    min-width: 900px;
    min-height: 560px;
}

.task-editor-toolbar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 7px 8px;
    margin-bottom: 6px;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-database-field {
    flex-grow: 1;
    min-width: 220px;
    margin-right: 8px;
    flex-wrap: nowrap;
    flex-direction: row;
}

.task-editor-folder-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 8px 4px;
    margin-bottom: 7px;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-id-source-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 3px 8px 4px;
    margin-bottom: 7px;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-folder-host {
    flex-grow: 1;
    min-width: 0;
}

.task-editor-folder-field {
    flex-grow: 1;
    min-width: 0;
}

.task-editor-id-source-field {
    flex-grow: 1;
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
}

.task-editor-main-split {
    flex-grow: 1;
    min-height: 0;
}

.task-editor-left-split {
    flex-grow: 1;
    min-height: 0;
}

.task-editor-sidebar {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-radius: 6px;
}

.task-editor-details-pane {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    border-width: 1px;
    border-radius: 6px;
}

.task-editor-sidebar {
    padding: 5px;
    margin-right: 5px;
}

.task-editor-details-pane {
    padding: 5px;
    margin-left: 5px;
}

.task-editor-list-pane {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
    border-radius: 5px;
}

.task-editor-suffix-pane {
    flex-grow: 1;
    min-height: 0;
    padding: 8px;
    border-radius: 5px;
}

.task-editor-filter-grid {
    flex-shrink: 0;
    padding: 4px 6px 7px;
    margin-bottom: 5px;
    border-radius: 4px;
}

.task-editor-filter-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-wrap: wrap;
}

.task-editor-filter-row > DropdownField {
    flex-grow: 1;
    min-width: 0;
}

.task-editor-task-list {
    flex-grow: 1;
    min-height: 80px;
    background-color: transparent;
}

.task-editor-list-status {
    flex-shrink: 0;
    padding: 6px 8px;
    margin-top: 5px;
    white-space: normal;
    border-radius: 4px;
}

.task-editor-pane-title {
    unity-font-style: bold;
    margin: 2px 0 7px;
    padding-bottom: 5px;
}

.task-editor-suffix-options-card {
    padding: 7px;
    margin: 5px 0;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-suffix-form-card {
    padding: 7px;
    margin: 5px 0;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-suffix-list {
    flex-grow: 1;
    min-height: 40px;
    max-height: 145px;
    margin-top: 4px;
    background-color: transparent;
}

.task-editor-suffix-actions {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.task-editor-suffix-actions > Button {
    flex-grow: 1;
    margin-right: 4px;
}

.task-editor-suffix-actions > Button:last-child {
    margin-right: 0;
}

.task-editor-details-scroll {
    flex-grow: 1;
    min-height: 0;
    padding: 8px 10px 12px;
    border-radius: 5px;
    background-color: transparent;
}

.task-editor-empty-details {
    flex-grow: 1;
    align-self: center;
    -unity-text-align: middle-center;
    color: rgb(170, 170, 170);
}

.task-editor-detail-status {
    flex-shrink: 0;
    padding: 7px 10px;
    margin-top: 6px;
    white-space: normal;
    border-radius: 4px;
}

.task-editor-detail-section {
    padding: 8px 10px 9px;
    margin: 2px 0 10px;
    border-width: 1px;
    border-radius: 6px;
}

.task-editor-section-header {
    flex-direction: row;
    align-items: baseline;
    margin-bottom: 6px;
    padding-bottom: 6px;
    border-bottom-width: 1px;
}

.task-editor-section-header > Label:first-child {
    unity-font-style: bold;
    font-size: 14px;
}

.task-editor-section-header #SectionDescription {
    min-width: 0;
    margin-left: 9px;
    font-size: 11px;
    white-space: normal;
}

.task-editor-section-content {
    padding: 1px 2px 0;
}

.task-editor-property {
    margin-bottom: 5px;
}

.task-editor-stage-card {
    padding: 5px 9px 9px;
    margin: 7px 0;
    border-width: 1px;
    border-radius: 5px;
}

.task-editor-stage-actions {
    flex-direction: row;
    justify-content: flex-end;
    padding-bottom: 3px;
}

.task-editor-stage-actions > Button {
    min-width: 34px;
    margin-left: 4px;
}

.task-editor-add-stage {
    margin: 8px 0 2px;
}

.task-editor-list-row {
    flex-direction: column;
    justify-content: center;
    height: 100%;
    min-height: 48px;
    padding: 5px 8px;
    border-radius: 4px;
}

.task-editor-list-row.is-selected {
    border-left-width: 3px;
}

.task-editor-list-row.is-invalid .task-editor-row-title {
    color: rgb(226, 150, 130);
}

.task-editor-list-row.is-invalid .task-editor-row-id {
    color: rgb(226, 150, 130);
}

.task-editor-row-title {
    flex-shrink: 0;
    unity-font-style: bold;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.task-editor-row-metadata {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.task-editor-row-category {
    min-width: 48px;
}

.task-editor-row-id {
    flex-grow: 1;
    min-width: 0;
    font-size: 10px;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.task-editor-row-state {
    margin-left: 5px;
    font-size: 10px;
}

.task-editor-suffix-row {
    flex-direction: row;
    align-items: center;
    min-height: 34px;
    padding: 4px 6px;
    border-radius: 3px;
}

.task-editor-suffix-row.is-selected {
    border-left-width: 3px;
}

.task-editor-suffix-row #SuffixId {
    min-width: 110px;
    unity-font-style: bold;
}

.task-editor-suffix-row #SuffixDescription {
    flex-grow: 1;
    min-width: 0;
    white-space: nowrap;
    -unity-text-overflow-position: end;
}

.task-editor-danger-button {
    border-width: 1px;
    unity-font-style: bold;
}

.task-editor-theme-dark .task-editor-toolbar {
    background-color: rgb(42, 42, 42);
    border-color: rgb(64, 64, 64);
}

.task-editor-theme-dark .task-editor-folder-row {
    background-color: rgb(42, 42, 42);
    border-color: rgb(64, 64, 64);
}

.task-editor-theme-dark .task-editor-id-source-row {
    background-color: rgb(42, 42, 42);
    border-color: rgb(64, 64, 64);
}

.task-editor-theme-dark .task-editor-sidebar {
    background-color: rgb(30, 30, 30);
    border-color: rgb(56, 56, 56);
}

.task-editor-theme-dark .task-editor-details-pane {
    background-color: rgb(30, 30, 30);
    border-color: rgb(56, 56, 56);
}

.task-editor-theme-dark .task-editor-list-pane {
    background-color: rgb(38, 38, 38);
}

.task-editor-theme-dark .task-editor-suffix-pane {
    background-color: rgb(38, 38, 38);
}

.task-editor-theme-dark .task-editor-detail-section {
    background-color: rgb(38, 38, 38);
}

.task-editor-theme-dark .task-editor-filter-grid {
    background-color: rgb(47, 47, 47);
}

.task-editor-theme-dark .task-editor-suffix-options-card {
    background-color: rgb(47, 47, 47);
}

.task-editor-theme-dark .task-editor-suffix-form-card {
    background-color: rgb(47, 47, 47);
}

.task-editor-theme-dark .task-editor-detail-section {
    border-color: rgb(66, 66, 66);
}

.task-editor-theme-dark .task-editor-suffix-options-card {
    border-color: rgb(66, 66, 66);
}

.task-editor-theme-dark .task-editor-suffix-form-card {
    border-color: rgb(66, 66, 66);
}

.task-editor-theme-dark .task-editor-stage-card {
    background-color: rgb(43, 43, 43);
    border-color: rgb(72, 72, 72);
}

.task-editor-theme-dark .task-editor-section-header {
    border-bottom-color: rgb(70, 70, 70);
}

.task-editor-theme-dark .task-editor-section-header #SectionDescription {
    color: rgb(174, 174, 174);
}

.task-editor-theme-dark .task-editor-row-id {
    color: rgb(174, 174, 174);
}

.task-editor-theme-dark .task-editor-suffix-row #SuffixDescription {
    color: rgb(174, 174, 174);
}

.task-editor-theme-dark .task-editor-row-category {
    color: rgb(199, 177, 139);
}

.task-editor-theme-dark .task-editor-suffix-row #SuffixId {
    color: rgb(199, 177, 139);
}

.task-editor-theme-dark .task-editor-row-state {
    color: rgb(164, 190, 157);
}

.task-editor-theme-dark .task-editor-list-row {
    background-color: rgb(44, 44, 44);
}

.task-editor-theme-dark .task-editor-list-row:hover {
    background-color: rgb(56, 56, 56);
}

.task-editor-theme-dark .task-editor-suffix-row:hover {
    background-color: rgb(56, 56, 56);
}

.task-editor-theme-dark .task-editor-list-row.is-selected {
    background-color: rgb(63, 58, 49);
    border-left-color: rgb(174, 140, 83);
}

.task-editor-theme-dark .task-editor-suffix-row.is-selected {
    background-color: rgb(63, 58, 49);
    border-left-color: rgb(174, 140, 83);
}

.task-editor-theme-dark .task-editor-list-row.is-invalid {
    background-color: rgb(70, 46, 43);
}

.task-editor-theme-dark .task-editor-list-status {
    background-color: rgb(36, 36, 36);
}

.task-editor-theme-dark .task-editor-detail-status {
    background-color: rgb(36, 36, 36);
}

.task-editor-theme-dark .task-editor-danger-button {
    color: rgb(255, 236, 232);
    background-color: rgb(137, 52, 49);
    border-color: rgb(177, 80, 73);
}

.task-editor-theme-dark .task-editor-danger-button:hover {
    background-color: rgb(168, 61, 55);
}

.task-editor-theme-dark .task-editor-danger-button:disabled {
    color: rgb(161, 146, 143);
    background-color: rgb(80, 54, 52);
    border-color: rgb(100, 72, 69);
}

.task-editor-theme-light .task-editor-toolbar {
    background-color: rgb(239, 238, 235);
    border-color: rgb(202, 200, 195);
}

.task-editor-theme-light .task-editor-folder-row {
    background-color: rgb(239, 238, 235);
    border-color: rgb(202, 200, 195);
}

.task-editor-theme-light .task-editor-id-source-row {
    background-color: rgb(239, 238, 235);
    border-color: rgb(202, 200, 195);
}

.task-editor-theme-light .task-editor-sidebar {
    background-color: rgb(247, 246, 243);
    border-color: rgb(207, 205, 199);
}

.task-editor-theme-light .task-editor-details-pane {
    background-color: rgb(247, 246, 243);
    border-color: rgb(207, 205, 199);
}

.task-editor-theme-light .task-editor-list-pane {
    background-color: rgb(239, 238, 235);
}

.task-editor-theme-light .task-editor-suffix-pane {
    background-color: rgb(239, 238, 235);
}

.task-editor-theme-light .task-editor-detail-section {
    background-color: rgb(239, 238, 235);
}

.task-editor-theme-light .task-editor-filter-grid {
    background-color: rgb(232, 231, 227);
}

.task-editor-theme-light .task-editor-suffix-options-card {
    background-color: rgb(232, 231, 227);
}

.task-editor-theme-light .task-editor-suffix-form-card {
    background-color: rgb(232, 231, 227);
}

.task-editor-theme-light .task-editor-detail-section {
    border-color: rgb(207, 205, 199);
}

.task-editor-theme-light .task-editor-suffix-options-card {
    border-color: rgb(207, 205, 199);
}

.task-editor-theme-light .task-editor-suffix-form-card {
    border-color: rgb(207, 205, 199);
}

.task-editor-theme-light .task-editor-stage-card {
    background-color: rgb(248, 247, 244);
    border-color: rgb(205, 203, 197);
}

.task-editor-theme-light .task-editor-section-header {
    border-bottom-color: rgb(211, 209, 203);
}

.task-editor-theme-light .task-editor-section-header #SectionDescription {
    color: rgb(91, 89, 84);
}

.task-editor-theme-light .task-editor-row-id {
    color: rgb(91, 89, 84);
}

.task-editor-theme-light .task-editor-suffix-row #SuffixDescription {
    color: rgb(91, 89, 84);
}

.task-editor-theme-light .task-editor-row-category {
    color: rgb(126, 98, 55);
}

.task-editor-theme-light .task-editor-suffix-row #SuffixId {
    color: rgb(126, 98, 55);
}

.task-editor-theme-light .task-editor-row-state {
    color: rgb(66, 104, 61);
}

.task-editor-theme-light .task-editor-list-row {
    background-color: rgb(247, 246, 243);
}

.task-editor-theme-light .task-editor-list-row:hover {
    background-color: rgb(234, 232, 226);
}

.task-editor-theme-light .task-editor-suffix-row:hover {
    background-color: rgb(234, 232, 226);
}

.task-editor-theme-light .task-editor-list-row.is-selected {
    background-color: rgb(230, 224, 213);
    border-left-color: rgb(153, 119, 65);
}

.task-editor-theme-light .task-editor-suffix-row.is-selected {
    background-color: rgb(230, 224, 213);
    border-left-color: rgb(153, 119, 65);
}

.task-editor-theme-light .task-editor-list-row.is-invalid {
    background-color: rgb(250, 231, 226);
}

.task-editor-theme-light .task-editor-list-status {
    background-color: rgb(232, 231, 227);
}

.task-editor-theme-light .task-editor-detail-status {
    background-color: rgb(232, 231, 227);
}

.task-editor-theme-light .task-editor-danger-button {
    color: rgb(255, 255, 255);
    background-color: rgb(176, 54, 49);
    border-color: rgb(145, 42, 37);
}

.task-editor-theme-light .task-editor-danger-button:hover {
    background-color: rgb(197, 62, 55);
}

.task-editor-theme-light .task-editor-danger-button:disabled {
    color: rgb(234, 222, 221);
    background-color: rgb(175, 127, 124);
    border-color: rgb(153, 109, 105);
}
