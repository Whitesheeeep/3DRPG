/* Character 窗口只保留业务差异；布局和颜色由 ConfigEditorCommon.uss 提供。 */
.character-config-editor-root { flex-direction: column; }
.character-config-database-field { min-width: 260px; flex-grow: 1; flex-shrink: 1; margin-right: 6px; }
.character-config-body { min-height: 360px; width: auto; height: auto; }
.character-config-body > .unity-two-pane-split-view__content-container,
.character-config-body > .unity-two-pane-split-view__pane,
.character-config-body > .unity-two-pane-split-view__dragline-anchor { min-width: 0; min-height: 0; }
.character-config-sidebar { flex-grow: 0; flex-basis: auto; }
.character-config-details-pane { flex-grow: 1; flex-basis: auto; flex-direction: column; }
.character-config-empty-list,
.character-config-empty-details { padding: 12px; }
.character-config-status { flex-shrink: 0; }
