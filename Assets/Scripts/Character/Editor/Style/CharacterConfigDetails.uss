.character-config-details-page { flex-direction: column; min-width: 0; max-width: 100%; padding-bottom: 8px; }
.character-config-preview-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    min-height: 116px;
    margin-bottom: 8px;
    padding: 8px;
    background-color: rgb(39, 39, 39);
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}
.character-config-preview-frame {
    width: 100px;
    height: 100px;
    min-width: 100px;
    align-items: center;
    justify-content: center;
    margin-right: 12px;
    background-color: rgb(52, 52, 52);
    border-width: 1px;
    border-color: rgb(95, 95, 95);
}
.character-config-preview-image { width: 92px; height: 92px; }
.character-config-preview-fallback {
    width: 92px;
    height: 92px;
    -unity-text-align: middle-center;
    color: rgb(145, 145, 145);
    font-size: 12px;
}
.character-config-preview-fields { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.character-config-preview-field { min-width: 0; max-width: 100%; }
.character-config-preview-fields .unity-base-field__label {
    width: 160px;
    min-width: 160px;
    max-width: 160px;
}
.character-config-preview-fields .unity-base-field__input { min-width: 0; max-width: 100%; }
