<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:Style src="project://database/Assets/Scripts/Character/Editor/Style/CharacterConfigDetails.uss" />
    <ui:VisualElement name="IdentityPage" class="character-config-details-page">
        <ui:Label text="基础配置" class="config-editor-section-title character-config-section-title" />
        <ui:TextField name="NameField" binding-path="identity.characterName" label="角色名称" is-delayed="false" class="config-editor-property-field character-config-property-field" />
        <uie:PropertyField name="RarityField" binding-path="identity.rarity" label="稀有度" class="config-editor-property-field character-config-property-field" />
        <uie:PropertyField name="CharacterIdField" binding-path="characterId" label="角色标识" class="config-editor-property-field character-config-property-field" />
        <uie:PropertyField name="PrefabAddressField" binding-path="presentation.prefabAddress" label="角色 Prefab 地址" class="config-editor-property-field character-config-property-field" />
        <ui:Label text="武器配置" class="config-editor-section-title character-config-section-title" />
        <uie:PropertyField name="AllowedWeaponTypesField" binding-path="equipmentRules.allowedWeaponTypes" label="允许装备的武器类型" class="config-editor-property-field character-config-property-field" />
        <uie:PropertyField name="DefaultWeaponTypeField" binding-path="equipmentRules.defaultWeaponType" label="默认武器类型" class="config-editor-property-field character-config-property-field" />
        <ui:Label text="角色图片" class="config-editor-section-title character-config-section-title" />
        <ui:VisualElement name="SideIconRow" class="character-config-preview-row">
            <ui:VisualElement class="character-config-preview-frame">
                <ui:Image name="SideIconPreviewImage" class="character-config-preview-image" picking-mode="Ignore" />
                <ui:Label name="SideIconPreviewFallback" text="未选择" class="character-config-preview-fallback" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="character-config-preview-fields">
                <uie:ObjectField name="SideIconField" label="编辑器预览 Sprite" class="config-editor-property-field character-config-preview-field" />
                <uie:PropertyField name="SideIconAddressField" binding-path="presentation.sideIconAddress" label="图集 Address" class="config-editor-property-field character-config-property-field" />
                <uie:PropertyField name="SideIconSpriteNameField" binding-path="presentation.sideIconSpriteName" label="SpriteName" class="config-editor-property-field character-config-property-field" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="AvatarRow" class="character-config-preview-row">
            <ui:VisualElement class="character-config-preview-frame">
                <ui:Image name="AvatarPreviewImage" class="character-config-preview-image" picking-mode="Ignore" />
                <ui:Label name="AvatarPreviewFallback" text="未选择" class="character-config-preview-fallback" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="character-config-preview-fields">
                <uie:ObjectField name="AvatarField" label="编辑器预览 Sprite" class="config-editor-property-field character-config-preview-field" />
                <uie:PropertyField name="AvatarAddressField" binding-path="presentation.avatarAddress" label="图集 Address" class="config-editor-property-field character-config-property-field" />
                <uie:PropertyField name="AvatarSpriteNameField" binding-path="presentation.avatarSpriteName" label="SpriteName" class="config-editor-property-field character-config-property-field" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="FullBodyPortraitRow" class="character-config-preview-row">
            <ui:VisualElement class="character-config-preview-frame character-config-preview-frame--portrait">
                <ui:Image name="FullBodyPortraitPreviewImage" class="character-config-preview-image character-config-preview-image--portrait" picking-mode="Ignore" />
                <ui:Label name="FullBodyPortraitPreviewFallback" text="未选择" class="character-config-preview-fallback character-config-preview-fallback--portrait" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="character-config-preview-fields">
                <uie:ObjectField name="FullBodyPortraitField" label="编辑器预览 Sprite" class="config-editor-property-field character-config-preview-field" />
                <uie:PropertyField name="FullBodyPortraitAddressField" binding-path="presentation.fullBodyPortraitAddress" label="全身立绘图集 Address" class="config-editor-property-field character-config-property-field" />
                <uie:PropertyField name="FullBodyPortraitSpriteNameField" binding-path="presentation.fullBodyPortraitSpriteName" label="SpriteName" class="config-editor-property-field character-config-property-field" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="初始属性" class="config-editor-section-title character-config-section-title" />
        <uie:PropertyField name="InitialAttributeSetsField" binding-path="progression.initialAttributeSets" label="初始属性集" class="config-editor-property-field character-config-property-field" />
        <ui:Label text="战斗配置" class="config-editor-section-title character-config-section-title" />
        <uie:PropertyField name="NormalAttackAbilitiesField" binding-path="combatConfig.normalAttackAbilities" label="普攻连段" class="config-editor-property-field character-config-property-field" />
        <ui:HelpBox name="EmptyNormalAttackWarning" text="当前角色未配置普通攻击连段。该配置可以正常运行，但 Primary 输入不会触发能力。" message-type="Warning" />
        <uie:PropertyField name="SkillInputBindingsField" binding-path="combatConfig.skillInputBindings" label="技能输入绑定" class="config-editor-property-field character-config-property-field" />
        <ui:Label text="移动配置" class="config-editor-section-title character-config-section-title" />
        <uie:PropertyField name="GravityField" binding-path="locomotion.gravity" label="重力" class="config-editor-property-field character-config-property-field" />
        <uie:PropertyField name="TransitionField" binding-path="locomotion.locomotionTransition" label="Locomotion 状态过渡" class="config-editor-property-field character-config-property-field" />
        <ui:VisualElement name="CharacterGrowthDetailsHost" />
    </ui:VisualElement>
</ui:UXML>
