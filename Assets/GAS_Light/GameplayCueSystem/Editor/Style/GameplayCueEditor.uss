.cue-page {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.cue-toolbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 38px;
    padding-left: 8px;
    padding-right: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(63, 63, 63);
}

.cue-database-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 240px;
    margin-right: 6px;
}

.cue-database-field > .unity-base-field__label {
    min-width: 88px;
    -unity-font-style: bold;
}

.cue-main-split {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.cue-assets-panel {
    min-width: 210px;
    min-height: 0;
    padding: 6px;
    border-right-width: 1px;
    border-right-color: rgb(69, 69, 69);
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.cue-list-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.cue-list-toolbar > * {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-right: 4px;
    padding-left: 3px;
    padding-right: 3px;
}

.cue-search {
    flex-shrink: 0;
    margin-bottom: 5px;
}

.cue-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    border-top-width: 0;
    border-top-color: rgb(69, 69, 69);
}

.cue-details-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    padding: 8px 10px;
}

.cue-details-host {
    flex-shrink: 0;
    min-width: 0;
}

.cue-validation-host {
    flex-shrink: 0;
    min-width: 0;
}

.cue-validation-host {
    margin-top: 8px;
}

.cue-details-title {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.cue-resource-box {
    margin-top: 8px;
    padding: 6px;
    background-color: rgb(43, 43, 43);
}

.cue-row {
    height: 42px;
    padding-left: 6px;
    padding-right: 4px;
    justify-content: center;
}

.cue-row-main {
    flex-direction: row;
    align-items: center;
}

.cue-row-name {
    flex-grow: 1;
    -unity-font-style: bold;
}

.cue-row-rename {
    flex-grow: 1;
    display: none;
}

.cue-row--renaming .cue-row-name {
    display: none;
}

.cue-row--renaming .cue-row-rename {
    display: flex;
}

.cue-row-ping {
    width: 42px;
    min-width: 42px;
    margin-left: 4px;
}

.cue-row-action {
    width: 42px;
    min-width: 42px;
    margin-left: 2px;
}

.cue-row-tag {
    color: rgb(158, 158, 158);
    font-size: 10px;
}

.cue-row.has-validation-error {
    background-color: rgba(150, 55, 55, 0.55);
}

.cue-row.has-validation-warning {
    background-color: rgba(155, 125, 45, 0.45);
}

.cue-validation-title {
    margin-top: 12px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}
