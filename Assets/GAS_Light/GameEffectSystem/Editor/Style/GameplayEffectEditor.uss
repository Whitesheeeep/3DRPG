.ge-page {
    flex-grow: 1;
    min-height: 0;
}

.ge-toolbar,
.ge-modifier-header,
.ge-validation-header {
    flex-direction: row;
    align-items: center;
    padding: 6px;
}

.ge-toolbar > .unity-button,
.ge-modifier-header > .unity-button,
.ge-validation-header > .unity-button {
    margin-right: 4px;
}

.ge-toolbar {
    border-bottom-width: 1px;
    border-bottom-color: #343434;
}

.ge-grow {
    flex-grow: 1;
}

.ge-search {
    width: 230px;
}

.ge-main-split,
.ge-details-host,
.ge-details-page,
.ge-details-root {
    flex-grow: 1;
    min-height: 0;
}

.ge-details-host,
.ge-details-page {
    min-width: 0;
}

.ge-assets-panel {
    padding: 6px;
    border-right-width: 1px;
    border-right-color: #343434;
}

.ge-asset-list {
    flex-grow: 1;
    min-height: 0;
}

.ge-details-scroll {
    flex-grow: 1;
    padding: 8px 10px;
}

.ge-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 5px;
    margin-bottom: 5px;
}

.ge-effect-title {
    -unity-font-style: bold;
    font-size: 17px;
    margin-bottom: 8px;
}

.ge-empty-label {
    color: #9a9a9a;
    -unity-text-align: middle-center;
    padding: 14px;
}

.ge-config-group {
    margin-top: 5px;
}

.ge-modifier-header,
.ge-validation-header {
    padding-left: 0;
    padding-right: 0;
    margin-top: 8px;
}

.ge-modifier-split {
    height: 250px;
    min-height: 160px;
    border-width: 1px;
    border-color: #3b3b3b;
}

.ge-modifier-list {
    flex-grow: 1;
}

.ge-modifier-details {
    flex-grow: 1;
    padding: 6px;
    overflow: hidden;
}

.ge-validation-container {
    margin-bottom: 10px;
}

.ge-validation-container > .unity-help-box {
    margin-top: 2px;
    margin-bottom: 2px;
}

.ge-row {
    flex-grow: 1;
    justify-content: center;
    padding-left: 5px;
    padding-right: 5px;
}

.ge-effect-row {
    flex-direction: column;
}

.ge-effect-row.has-validation-error {
    background-color: rgba(132, 42, 42, 0.58);
}

.ge-effect-row.has-validation-warning {
    background-color: rgba(137, 109, 31, 0.52);
}

.ge-effect-row-header {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
}

.is-hidden {
    display: none;
}

.ge-row-rename {
    flex-grow: 1;
    height: 20px;
    margin: 0;
}

.ge-effect-ping {
    width: 38px;
    height: 18px;
    min-width: 38px;
    min-height: 18px;
    margin-left: 4px;
    margin-right: 0;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 9px;
}

.ge-effect-ping:hover {
    background-color: #4a6175;
}

.ge-row-name {
    flex-grow: 1;
}

.ge-row-path {
    color: #858585;
    font-size: 9px;
    white-space: nowrap;
}

.ge-modifier-row {
    flex-direction: row;
    align-items: center;
}

.ge-modifier-index {
    width: 24px;
    color: #888888;
}

.ge-modifier-attribute {
    color: #8da6bf;
    min-width: 72px;
    -unity-text-align: middle-right;
}
