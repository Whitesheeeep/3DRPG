<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/GAS_Light/AbilitySystem/Editor/Style/GameplayAbilityEditor.uss?fileID=7433441132597879392&amp;guid=7d000429d62f7454f8a64a9ca2271eb7&amp;type=3#GameplayAbilityEditor" />
    <ui:VisualElement class="ga-editor">
        <ui:VisualElement class="ga-bake-toolbar">
            <uie:ObjectField name="DatabaseField" label="Gameplay Ability Database" class="ga-database-field" style="flex-shrink: 1;" />
            <ui:Button name="BakeAbilityButton" text="Bake" />
            <ui:Label name="BakeStatusLabel" text="Not Baked" class="ga-bake-status" />
        </ui:VisualElement>
        <ui:VisualElement class="ga-toolbar">
            <ui:Button name="CreateAbilityButton" text="Create" />
            <ui:Button name="DuplicateAbilityButton" text="Duplicate" />
            <ui:Button name="DeleteAbilityButton" text="Delete" />
            <ui:VisualElement class="ga-toolbar-spacer" />
            <uie:ToolbarSearchField name="SearchField" class="ga-search" />
        </ui:VisualElement>
        <ui:TwoPaneSplitView fixed-pane-index="0" fixed-pane-initial-dimension="245">
            <ui:VisualElement class="ga-assets-pane">
                <ui:Label text="Gameplay Abilities" class="ga-section-title" />
                <ui:ListView name="AbilityList" class="ga-ability-list" />
            </ui:VisualElement>
            <ui:ScrollView class="ga-details-scroll">
                <ui:Label name="AbilityTitle" text="No Gameplay Ability Selected" class="ga-details-title" />
                <ui:VisualElement name="AbilityDetailsRoot" class="ga-details-root">
                    <ui:Label text="Ability" class="ga-section-title" />
                    <ui:Label name="AbilityIdLabel" text="Ability ID: Unbaked" class="ga-ability-id" />
                    <uie:PropertyField binding-path="description" label="Description" />
                    <uie:PropertyField binding-path="abilityTags" label="Ability Tags" />
                    <uie:PropertyField binding-path="cancelTags" label="Cancel Tags" />
                    <uie:PropertyField binding-path="activationTagQuery" label="Activation Tag Query" />
                    <ui:Label text="Commit" class="ga-section-title ga-section-gap" />
                    <uie:PropertyField binding-path="costEffect" label="Cost Effect" />
                    <uie:PropertyField binding-path="cooldownEffect" label="Cooldown Effect" />
                    <uie:PropertyField binding-path="effects" label="Effects" />
                    <uie:PropertyField binding-path="cueTags" label="Cue Tags" />
                    <ui:Label text="Specific Ability" class="ga-section-title ga-section-gap" />
                    <ui:VisualElement name="SubclassFieldsContainer" />
                    <ui:Label text="Validation" class="ga-section-title ga-section-gap" />
                    <ui:VisualElement name="ValidationContainer" class="ga-validation" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:TwoPaneSplitView>
    </ui:VisualElement>
</ui:UXML>
